# AgentBox Configuration

AGENTBOX_PORT=8054
LOG_LEVEL=info

# Feature toggle (SPEC §10). "true" for local dev — the filesystem, git
# and http_request tools are registered. Set to "false" and they are not
# registered with FastMCP at all: absent from list_tools(), not merely
# hidden. Any deployment profile other than local dev must default to
# false, as its own reviewed decision.
AGENTBOX_ENABLE_JUMPBOX_TOOLS=true

# Local auth (SPEC §12). Leave empty for no auth — that is the default and
# matches today's behaviour exactly. Set it to any shared secret and every
# MCP tool call and /api/* route must send `Authorization: Bearer <token>`.
# /health, /ui and /api/auth-required stay open. The /ui page prompts once
# and keeps the token in sessionStorage. This is NOT OAuth (Phase 2's job);
# it is the credential an OAuth wrapper would later sit in front of.
AGENTBOX_AUTH_TOKEN=

# Interactive terminal (SPEC §15). Its own toggle, separate from the
# jumpbox tools, and the only one defaulting to false: this is a real PTY.
# When false the WebSocket route is not registered at all. When true it
# ALSO requires AGENTBOX_AUTH_TOKEN above — the socket is fail-closed and
# refuses every connection with close code 4001 if no token is set.
# The shell runs as the unprivileged `agentbox` user, not root.
AGENTBOX_ENABLE_TERMINAL=false

# Git push (SPEC §16). Unset means clone and pull over HTTPS work, push does
# not. These name FILES, never the secret itself — an environment value is
# returned verbatim by `docker inspect`.
#
#   AGENTBOX_GIT_CREDENTIALS_FILE=/run/secrets/git_credentials
#     One line per forge, git credential-store format:
#       https://<user>:<fine-grained-token>@github.com
#     Mount 0400. Scope the token to the specific repositories that need
#     writing — nothing in this container can narrow a broad token.
#
#   AGENTBOX_GIT_SSH_KEY_FILE=/run/secrets/git_deploy_key
#   AGENTBOX_GIT_KNOWN_HOSTS_FILE=/run/secrets/known_hosts
#     For git over SSH. StrictHostKeyChecking stays ON, so known_hosts is
#     required — without it pushes refuse to connect, which is the safe
#     failure rather than a silent downgrade to trust-on-first-use.
AGENTBOX_GIT_CREDENTIALS_FILE=
AGENTBOX_GIT_SSH_KEY_FILE=
AGENTBOX_GIT_KNOWN_HOSTS_FILE=
