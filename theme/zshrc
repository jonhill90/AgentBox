# AgentBox zsh config — Powerlevel10k, matching Jon's dotfiles.
#
# Based on hill90-app's services/agentbox/theme/zshrc, with one
# deliberate difference: the `vcs` segment is KEPT. Hill90 removed it
# ("gitstatus binary not bundled in container"), which costs the git
# branch and status icons in the prompt. The Dockerfile pre-fetches the
# gitstatusd daemon at build time instead, so vcs works here.
#
# This file existing at all is also what stops zsh running its first-run
# configuration wizard, which otherwise eats the opening keystrokes of
# every session.

# Powerlevel10k instant prompt
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# Oh My Zsh
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="robbyrussell"  # overridden by p10k below
plugins=(git)
source $ZSH/oh-my-zsh.sh

# Powerlevel10k (installed system-wide, not per user)
source /usr/share/powerlevel10k/powerlevel10k.zsh-theme
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh

export PATH="$HOME/.local/bin:$PATH"
export EDITOR=vim

# The filesystem and git tools are scoped to /workspace, so start there —
# it is also where the vcs segment has something to report.
[[ ! -L ~/workspace ]] && ln -sf /workspace ~/workspace 2>/dev/null
cd /workspace 2>/dev/null || true
